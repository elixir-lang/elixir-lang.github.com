{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": [
    "popcorn/_build",
    "popcorn/deps",
    "popcorn/public",
    "dist",
    ".astro/collections",
    ".astro/fonts",
    ".astro/data-store.json",
    ".astro/content-assets.mjs",
    ".astro/content-modules.mjs",
    ".astro/settings.json"
  ],
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"]
}
