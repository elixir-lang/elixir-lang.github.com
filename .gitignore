playwright/.cache/
# Visual-regression baselines: large (tens of MB) and platform-specific
# (the locally generated ones are macOS "-darwin"; Linux CI can't use them).
# Keep them out of git - regenerate locally with
# `pnpm test:visual --update-snapshots`. For CI visual regression, generate
# "-linux" baselines inside the Playwright Docker image and store them there.
tests/**/*-snapshots/

# macOS-specific files
.DS_Store

