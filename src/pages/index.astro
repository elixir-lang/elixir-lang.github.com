---
import ElixirInProduction from "@/components/home/ElixirInProduction.astro";
import Hero from "@/components/home/Hero.astro";
import ShapedByMany from "@/components/home/ShapedByMany.astro";
import Stewards from "@/components/home/Stewards.astro";
import UseElixirFor from "@/components/home/UseElixirFor.astro";
import WhyElixir from "@/components/home/WhyElixir.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const seo = {
  title: undefined,
  description:
