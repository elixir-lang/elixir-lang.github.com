---
import { getEntry, render } from "astro:content";
import StandalonePage from "@/components/page/StandalonePage.astro";

// Legal policy: do not paraphrase; preserve the original section anchors.
const entry = await getEntry("standalonePages", "trademarks");
const Content = entry ? (await render(entry)).Content : null;

const title = "Trademarks policy";
const description =
  'Policy for allowed usage of the "Elixir" word and the Elixir logo.';
---

<StandalonePage title={title} description={description}>
  {Content && <Content />}
</StandalonePage>
