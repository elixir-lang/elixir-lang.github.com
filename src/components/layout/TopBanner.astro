---
import { topBannerHref } from "@/data/navigation";
---

<a
  href={topBannerHref}
  target="_blank"
  rel="noopener noreferrer"
  class="block w-full bg-purple-70 transition-colors duration-fast ease-out-quart hover:bg-purple-80"
>
  <div class="flex w-full items-center justify-center px-4 py-3 md:px-2.5">
    <div class="flex w-full max-w-[1440px] items-center justify-center px-0 md:px-12">
      <p
        class="font-sans text-caption leading-5 text-white-10 text-center md:whitespace-nowrap md:text-small md:leading-6"
      >
        <span class="font-normal">Something approaches: </span><span class="font-medium">Goatmire Elixir (28th Sep - 4th Oct 2026)</span><span class="font-normal">, participate in the celebration!</span>
      </p>
    </div>
  </div>
</a>
