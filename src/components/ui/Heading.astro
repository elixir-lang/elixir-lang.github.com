---
import { cn } from "@/utilities/classname";

interface Props {
  as?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  size?: "display" | "h1" | "h2" | "h3" | "h4";
  weight?: "regular" | "medium" | "bold" | "black";
  tone?: "default" | "on-dark" | "muted" | "brand";
  class?: string;
  id?: string;
}

const {
  as: Tag = "h2",
  size = "h2",
  weight = "bold",
  tone = "default",
  class: className,
  id,
} = Astro.props as Props;

const sizeClass = {
  display:
    "text-[2.5rem] sm:text-[3rem] md:text-[3.75rem] lg:text-[4.5rem] leading-[1.05] tracking-[-0.02em]",
  h1: "text-[2rem] sm:text-[2.5rem] md:text-[3rem] lg:text-[3.5rem] leading-[1.1] tracking-[-0.015em]",
  h2: "text-[1.75rem] sm:text-[2rem] md:text-[2.25rem] lg:text-[2.5rem] leading-[1.15] tracking-[-0.01em]",
  h3: "text-[1.375rem] sm:text-[1.5rem] md:text-[1.75rem] lg:text-[1.875rem] leading-[1.2]",
  h4: "text-[1.125rem] sm:text-[1.25rem] md:text-[1.5rem] leading-[1.25]",
}[size];

const weightClass = {
  regular: "font-normal",
  medium: "font-medium",
  bold: "font-bold",
  black: "font-black",
}[weight];

const toneClass = {
  default: "text-(--color-text-primary)",
  "on-dark": "text-(--color-text-on-dark)",
  muted: "text-(--color-text-muted-on-light)",
  brand: "text-(--color-brand)",
}[tone];
---

<Tag
  id={id}
  class={cn("font-(family-name:--font-display)", sizeClass, weightClass, toneClass, className)}
>
  <slot />
</Tag>
