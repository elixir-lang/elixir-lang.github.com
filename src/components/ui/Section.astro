---
import { cn } from "@/utilities/classname";

interface Props {
  as?: "section" | "div" | "article" | "aside";
  tone?: "default" | "dark" | "muted" | "brand";
  spacing?: "sm" | "md" | "lg" | "xl" | "none";
  class?: string;
  id?: string;
}

const {
  as: Tag = "section",
  tone = "default",
  spacing = "lg",
  class: className,
  id,
} = Astro.props as Props;

const toneClass = {
  default: "bg-(--color-white) text-(--color-text-primary)",
  dark: "bg-(--color-black) text-(--color-text-on-dark)",
  muted: "bg-(--color-surface-muted) text-(--color-text-primary)",
  brand: "bg-(--color-brand) text-(--color-text-on-dark)",
}[tone];

const spacingClass = {
  none: "",
  sm: "py-12 md:py-16",
  md: "py-16 md:py-20 lg:py-24",
  lg: "py-20 md:py-28 lg:py-32",
  xl: "py-24 md:py-36 lg:py-44",
}[spacing];
---

<Tag id={id} class={cn("relative", toneClass, spacingClass, className)}>
  <slot />
</Tag>
